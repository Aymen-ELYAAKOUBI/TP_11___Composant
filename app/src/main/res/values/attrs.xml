<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CircularScoreView">
        <attr name="score" format="integer" />
        <attr name="maxScore" format="integer" />
        <attr name="ringColor" format="color" />
        <attr name="progressColor" format="color" />
        <attr name="textColor" format="color" />
        <attr name="textSize" format="dimension" />
        <attr name="strokeWidth" format="dimension" />
    </declare-styleable>

    <declare-styleable name="RatingBarView">
        <attr name="rating" format="integer" />
        <attr name="maxRating" format="integer" />
        <attr name="starColorActive" format="color" />
        <attr name="starColorInactive" format="color" />
    </declare-styleable>
</resources>
